# Copy this file to ".env" (same folder) and put your own MySQL details in.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=f1_career_archive

# Used ONLY by "npm run test:db". The name MUST end in _test.
# The tests wipe and rebuild this database, never your real one.
DB_TEST_NAME=f1_career_archive_test

PORT=3002
